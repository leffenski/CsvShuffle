@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme"
                  IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<CascadingValue Value="this">
    @Body
</CascadingValue>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new MudTheme
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public bool IsDarkMode => _isDarkMode;

    public string ThemeToggleIcon => _isDarkMode
        ? Icons.Material.Filled.LightMode
        : Icons.Material.Filled.DarkMode;

    public string ThemeToggleLabel => _isDarkMode
        ? "Switch to light mode"
        : "Switch to dark mode";

    public void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#38A2A3",
        Secondary = "#03394D",
        Black = "#261A0D",
        AppbarText = "#261A0D",
        AppbarBackground = "#FFFDC2",
        DrawerBackground = "#FFFDC2",
        GrayLight = "#E8E2B0",
        GrayLighter = "#FFFEE0"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#38A2A3",
        Secondary = "#03394D",
        Surface = "#29150a",
        Background = "#261A0D",
        BackgroundGray = "#1E140A",
        AppbarText = "#FFFDC2",
        AppbarBackground = "#261A0DF2",
        DrawerBackground = "#261A0D",
        ActionDefault = "#38A2A3",
        ActionDisabled = "#FFFDC24D",
        ActionDisabledBackground = "#522A1580",
        TextPrimary = "#FFFDC2",
        TextSecondary = "#B8D4C2",
        TextDisabled = "#FFFDC280",
        DrawerIcon = "#38A2A3",
        DrawerText = "#FFFDC2",
        GrayLight = "#522A15",
        GrayLighter = "#38200F",
        Info = "#03394D",
        Success = "#38A2A3",
        Warning = "#FFFDC2",
        Error = "#FFFDC2",
        LinesDefault = "#6B452D",
        TableLines = "#6B452D",
        Divider = "#522A15",
        OverlayLight = "#261A0DCC"
    };

}
